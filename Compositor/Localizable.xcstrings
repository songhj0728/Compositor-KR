      }
    },
    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용 안 함을 선택하면 사진을 그대로 둡니다. 가이드를 선택하면 사진에 그린 선을 기준으로 수평/수직을 맞춥니다."
          }
        }
      }
    },
    "Off saves each adjustment as the pixels it makes, for apps that can't read adjustment layers" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "끄면 조정 레이어를 읽지 못하는 앱을 위해 각 조정 결과를 픽셀로 저장합니다."
          }
