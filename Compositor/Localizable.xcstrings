      }
    },
    "Drag a color in the picture. Nearby color families move together." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사진에서 색상을 드래그합니다. 인접한 색상 계열이 함께 움직입니다."
          }
        }
      }
    },
    "Drag a divider to change which tones the neighboring sliders affect." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "구분선을 드래그하여 인접한 슬라이더가 영향을 미치는 톤을 변경합니다."
          }
        }
      }
    },
    "Drag a point. Click the curve to add one. Double-click a point to remove it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "점을 드래그합니다. 곡선을 클릭하여 점을 추가합니다. 점을 더블 클릭하여 삭제합니다."
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "휠 안쪽을 드래그합니다. 각도는 색조를, 중심에서의 거리는 채도를 설정합니다."
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "레이어를 드래그하여 안내선을 배치합니다. 선을 두 개 이상 그립니다."
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "드래그하거나 스크롤하여 이동합니다. 더블 클릭하면 맞춤과 100% 사이를 전환합니다."
          }
        }
      }
    },
    "Drag to resize the panel" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "드래그하여 패널 크기를 조절합니다"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "드래그하여 색조와 채도를 설정합니다. 더블 클릭하면 이 휠이 초기화됩니다."
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "큼직한 픽셀 하나하나를 단색 사각형으로 그리거나, 도트 매트릭스 화면처럼 둥근 점으로 그립니다."
          }
        }
      }
    },
